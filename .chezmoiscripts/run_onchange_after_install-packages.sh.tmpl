{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh

set -eu

# {{ include "dot_config/mise/config.toml" | sha256sum }}

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew is required before applying these dotfiles." >&2
    exit 1
fi

brew bundle --file=/dev/stdin <<'EOF'
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ else if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "fedora" -}}
sudo dnf install -y{{ range .packages.fedora.dnf }} {{ . | quote }}{{ end }}
{{ else if eq .chezmoi.osRelease.id "ubuntu" -}}
sudo apt-get update
sudo apt-get install -y{{ range .packages.ubuntu.apt }} {{ . | quote }}{{ end }}

# Start Fcitx 5 in the desktop session, as fcitx5-autostart does on Fedora.
im-config -n fcitx5
{{ else -}}
echo "Automatic package installation is currently supported on Fedora and Ubuntu only." >&2
exit 0
{{ end }}
if ! command -v mise >/dev/null 2>&1; then
    curl https://mise.run | sh
fi
{{ end }}
MISE_BIN=$(command -v mise || printf '%s' "$HOME/.local/bin/mise")
"$MISE_BIN" install
{{ end -}}
