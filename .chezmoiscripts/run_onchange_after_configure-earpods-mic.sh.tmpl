{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# This workaround is specific to the ASRock ALC897 codec used on this desktop.
matched=false
for codec in /sys/class/sound/hwC*D*; do
    [ -r "$codec/vendor_id" ] || continue
    [ "$(cat "$codec/vendor_id")" = "0x10ec0897" ] || continue
    [ "$(cat "$codec/subsystem_id")" = "0x18491897" ] || continue
    matched=true
    break
done
[ "$matched" = true ] || exit 0

as_root() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

if [ ! -x /usr/bin/hda-verb ]; then
    if [ ! -r /etc/fedora-release ]; then
        echo 'Install hda-verb (alsa-tools) before configuring the EarPods mic.' >&2
        exit 1
    fi
    as_root dnf install -y alsa-tools
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cat > "$stage/earpods-mic-bias" <<'EOF'
{{ include ".chezmoitemplates/audio/earpods-mic-bias" }}
EOF
cat > "$stage/earpods-mic-bias.service" <<'EOF'
{{ include ".chezmoitemplates/audio/earpods-mic-bias.service" }}
EOF
cat > "$stage/earpods-mic-bias.timer" <<'EOF'
{{ include ".chezmoitemplates/audio/earpods-mic-bias.timer" }}
EOF

as_root install -D -m 0755 "$stage/earpods-mic-bias" /usr/local/sbin/earpods-mic-bias
as_root install -D -m 0644 "$stage/earpods-mic-bias.service" /etc/systemd/system/earpods-mic-bias.service
as_root install -D -m 0644 "$stage/earpods-mic-bias.timer" /etc/systemd/system/earpods-mic-bias.timer
as_root systemctl daemon-reload
# Replace the previous boot-only service, including its RemainAfterExit state.
as_root systemctl enable earpods-mic-bias.service
as_root systemctl restart earpods-mic-bias.service
as_root systemctl enable --now earpods-mic-bias.timer
{{ end -}}
