#!/bin/sh
set -eu

# Card numbers change with USB device enumeration; identify the codec instead.
for codec in /sys/class/sound/hwC*D*; do
    [ -r "$codec/vendor_id" ] || continue
    [ "$(cat "$codec/vendor_id")" = "0x10ec0897" ] || continue
    [ "$(cat "$codec/subsystem_id")" = "0x18491897" ] || continue

    # Keep the override for subsequent codec initialization without duplicates.
    if ! grep -q '^0x19 0x707 0x0025$' "$codec/init_verbs"; then
        printf '%s\n' '0x19 0x707 0x25' > "$codec/init_verbs"
    fi

    current=$(/usr/bin/hda-verb "/dev/snd/${codec##*/}" 0x19 GET_PIN_WIDGET_CONTROL 0 2>/dev/null)
    # Correct only the observed VREF_80 reset. Leave disabled/other pin modes alone.
    if printf '%s\n' "$current" | grep -q '^value = 0x24$'; then
        /usr/bin/hda-verb "/dev/snd/${codec##*/}" 0x19 SET_PIN_WIDGET_CONTROL 0x25
    fi
    exit 0
done

# A temporarily unavailable codec should not produce repeated timer failures.
exit 0
